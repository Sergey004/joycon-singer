#-------------------------------------------------------------------------------
# Makefile for joycon-singer (Nintendo Switch homebrew)
# Uses the standard devkitPro libnx Makefile template.
#-------------------------------------------------------------------------------

TARGET      := joycon-singer
SOURCES     := .
INCLUDES    := .

APP_TITLE   := JoyCon Singer
APP_AUTHOR  := Sergey004
APP_VERSION := 0.0.1

LIBS        := -lnx -lm
LDFLAGS     :=
CFLAGS      :=
CXXFLAGS    := -std=gnu++17

ifneq ($(DEVKITPRO),)
    include $(DEVKITPRO)/libnx/switch_rules
else
    $(error DEVKITPRO is not set. Run: export DEVKITPRO=/opt/devkitpro)
endif

BUILD       := build
OUTPUT      := $(CURDIR)
ARCH        := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec

CFLAGS      += -g -Wall -O2 $(ARCH) \
               -ffunction-sections -fdata-sections \
               -D__SWITCH__ \
               $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
               -I$(DEVKITPRO)/libnx/include

CXXFLAGS    += $(CFLAGS) -fno-rtti -fno-exceptions

LDFLAGS     += -specs=$(DEVKITPRO)/libnx/switch.specs $(ARCH) \
               -Wl,-Map,$(notdir $*.map) \
               -L$(DEVKITPRO)/libnx/lib

NACP_FLAGS  := --titleid=0000000000000000

# Изолируем сборку Switch-версии только от этого файла, чтобы не подцепить main_pc.cpp
CFILES      := 
CPPFILES    := $(SOURCES)/main_switch.cpp
OFILES      := $(patsubst %.cpp,$(BUILD)/%.cpp.o, $(CPPFILES))
DEPFILES    := $(OFILES:.o=.d)

VPATH       := $(SOURCES)

.PHONY: all clean

all: $(OUTPUT)/$(TARGET).nro

$(OUTPUT)/$(TARGET).nro: $(OUTPUT)/$(TARGET).nacp $(BUILD)/$(TARGET).elf

$(BUILD)/$(TARGET).elf: $(OFILES)
	@mkdir -p $(BUILD)
	$(CXX) $(LDFLAGS) $^ $(LIBS) -o $@

$(BUILD)/%.cpp.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

clean:
	@rm -rf $(BUILD) $(OUTPUT)/$(TARGET).nro $(OUTPUT)/$(TARGET).nacp $(OUTPUT)/$(TARGET).elf

-include $(DEPFILES)