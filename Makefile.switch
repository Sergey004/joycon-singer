#-------------------------------------------------------------------------------
# Makefile for joycon-singer (Nintendo Switch homebrew)
#-------------------------------------------------------------------------------

TARGET      := joycon-singer
SOURCES     := .
INCLUDES    := .

APP_TITLE   := JoyCon Singer
APP_AUTHOR  := Sergey004
APP_VERSION := 0.0.1

ifneq ($(DEVKITPRO),)
    include $(DEVKITPRO)/libnx/switch_rules
else
    $(error DEVKITPRO is not set. Run: export DEVKITPRO=/opt/devkitpro)
endif

# --- ИСПРАВЛЕНИЕ: Явно заставляем Make использовать aarch64-компилятор в качестве линковщика
CXX         := aarch64-none-elf-g++
CC          := aarch64-none-elf-gcc
LD          := $(CXX)

BUILD       := build
OUTPUT      := $(CURDIR)

ARCH        := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec

CFLAGS      := -g -Wall -O2 $(ARCH) \
               -ffunction-sections -fdata-sections \
               -D__SWITCH__ \
               $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
               -I$(DEVKITPRO)/libnx/include

CXXFLAGS    := $(CFLAGS) -fno-rtti -fno-exceptions -std=gnu++17

LDFLAGS     := -specs=$(DEVKITPRO)/libnx/switch.specs $(ARCH) \
               -Wl,-Map,$(TARGET).map \
               -L$(DEVKITPRO)/libnx/lib

LIBS        := -lnx -lm

NACP_FLAGS  := --titleid=0000000000000000

# Строго указываем только нужный файл, чтобы не цеплять исходники для PC
CPPFILES    := main_switch.cpp
OFILES      := $(patsubst %.cpp,$(BUILD)/%.o, $(CPPFILES))
DEPFILES    := $(OFILES:.o=.d)

.PHONY: all clean

all: $(OUTPUT)/$(TARGET).nro

$(OUTPUT)/$(TARGET).nro: $(OUTPUT)/$(TARGET).nacp $(OUTPUT)/$(TARGET).elf

# Явное правило линковки, предотвращающее использование системного `ld`
$(OUTPUT)/$(TARGET).elf: $(OFILES)
	@mkdir -p $(dir $@)
	@echo "Linking $@"
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "Compiling $<"
	$(CXX) $(CXXFLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

clean:
	@rm -rf $(BUILD) $(OUTPUT)/$(TARGET).nro $(OUTPUT)/$(TARGET).nacp $(OUTPUT)/$(TARGET).elf $(TARGET).map

-include $(DEPFILES)