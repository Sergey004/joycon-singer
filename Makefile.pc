#-------------------------------------------------------------------------------
# Makefile.pc — JoyCon Singer, PC / SBC / Mac build
#-------------------------------------------------------------------------------

TARGET   := joycon-singer
SOURCES  := .
INCLUDES := .

ARCH ?= native

# ---- Detect OS ----
UNAME_S := $(shell uname -s)
UNAME_M := $(shell uname -m)

ifeq ($(UNAME_S),Darwin)
    OS := macos
else
    OS := linux
endif

# ---- Toolchain ----
ifeq ($(ARCH),aarch64)
    CROSS     := aarch64-linux-gnu-
    ARCHFLAGS := -march=armv8-a+crc -mtune=cortex-a53
else ifeq ($(ARCH),armv7)
    CROSS     := arm-linux-gnueabihf-
    ARCHFLAGS := -march=armv7-a -mfpu=neon-vfpv4 -mfloat-abi=hard -mtune=cortex-a53
else ifeq ($(ARCH),armv6)
    CROSS     := arm-linux-gnueabihf-
    ARCHFLAGS := -march=armv6zk -mfpu=vfp -mfloat-abi=hard -mtune=arm1176jzf-s
else
    CROSS     :=
    ARCHFLAGS :=
    ifeq ($(OS),macos)
        ifeq ($(UNAME_M),arm64)
            ARCHFLAGS := -arch arm64
        else
            ARCHFLAGS := -arch x86_64
        endif
    endif
endif

CXX := $(CROSS)g++
PKG := $(CROSS)pkg-config

# ---- hidapi detection ----
ifeq ($(OS),macos)
    BREW_PREFIX := $(shell brew --prefix 2>/dev/null || echo "/usr/local")
    HIDAPI_CFLAGS := $(shell PKG_CONFIG_PATH="$(BREW_PREFIX)/lib/pkgconfig" pkg-config --cflags hidapi 2>/dev/null || echo "-I$(BREW_PREFIX)/include/hidapi")
    HIDAPI_LIBS   := $(shell PKG_CONFIG_PATH="$(BREW_PREFIX)/lib/pkgconfig" pkg-config --libs hidapi 2>/dev/null || echo "-L$(BREW_PREFIX)/lib -lhidapi")
    LDFLAGS_EXTRA := -framework IOKit -framework CoreFoundation
else
    HIDAPI_CFLAGS := $(shell $(PKG) --cflags hidapi-hidraw  2>/dev/null || $(PKG) --cflags hidapi-libusb  2>/dev/null || echo "-I/usr/include/hidapi")
    HIDAPI_LIBS   := $(shell $(PKG) --libs   hidapi-hidraw  2>/dev/null || $(PKG) --libs   hidapi-libusb  2>/dev/null || echo "-lhidapi")
    LDFLAGS_EXTRA :=
endif

CXXFLAGS := -std=c++17 -O2 -Wall -Wextra \
            $(ARCHFLAGS) \
            $(HIDAPI_CFLAGS) \
            $(foreach dir,$(INCLUDES),-I$(dir)) \
            -I$(SOURCES)

LDFLAGS  := $(HIDAPI_LIBS) $(LDFLAGS_EXTRA) -lm -lpthread

BUILD    := build_pc_$(ARCH)_$(OS)
OFILES   := $(BUILD)/main_pc.o

.PHONY: all clean info deploy

all: info $(TARGET)

info:
	@echo "  OS     = $(OS) ($(UNAME_M))"
	@echo "  ARCH   = $(ARCH)"
	@echo "  CXX    = $(CXX)"
	@echo "  hidapi = $(HIDAPI_LIBS)"
ifeq ($(OS),macos)
	@echo "  extra  = $(LDFLAGS_EXTRA)"
endif
	@echo ""

$(TARGET): $(OFILES)
	$(CXX) $^ $(LDFLAGS) -o $@
	@echo ""
	@echo "  OK: $(TARGET)"

$(BUILD)/main_pc.o: $(SOURCES)/main_pc.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

clean:
	@rm -rf build_pc_* $(TARGET)

-include $(wildcard $(BUILD)/*.d)

BOARD_IP ?= raspberrypi.local
deploy: $(TARGET)
	scp $(TARGET) pi@$(BOARD_IP):~/$(TARGET)
	@echo "  Deployed to pi@$(BOARD_IP):~/$(TARGET)"